# Electron 二进制默认从 GitHub 下载，国内直连经常超时（`RequestError: read ECONNRESET`）。
# 这里固定 npmmirror 镜像，让 `pnpm install` 在任何新机器上都能一次装完。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# Electron 生态（electron-builder 收集原生模块、asar 打包）对 pnpm 的符号链接布局兼容性差，
# 统一用扁平布局，避免后期打包阶段再回头改。
node-linker=hoisted
